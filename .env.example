# Cadence runtime env (root)
# Copy to `.env` (gitignored) and fill values.
# 모든 MCP servers + apps/routine + apps/cli가 dotenv로 이 파일을 자동 로드.

# ============================================================
# Plan 02 — MCP servers
# ============================================================

# --- Supabase (local dev) ---
# `pnpm supabase status`로 확인 가능. 로컬 dev 키는 모든 Supabase 인스턴스 공통.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# --- GitHub PAT (read-only) ---
# 발급: https://github.com/settings/tokens?type=beta
# 권한: Public Repositories (read), 또는 monitored_repos가 private이면 그 repo들에 contents: read
COACH_GITHUB_PAT=

# --- Discord admin webhook (헬스체크/실패 알림용) ---
# 발급: 채널 설정 → 통합 → 웹후크 → 새 웹후크 → URL 복사
DISCORD_ADMIN_WEBHOOK_URL=

# ============================================================
# Plan 03 — Routine + Agent + CLI (MVP 가동에 필수)
# ============================================================

# --- Anthropic Claude API ---
# 발급: https://console.anthropic.com/ → API keys → Create Key
# Routine이 매일 1회 messages.create() 호출 (Claude Opus 4.7 + cache_control)
ANTHROPIC_API_KEY=

# --- Coach user (Supabase Auth) ---
# Supabase Studio (http://127.0.0.1:54323) → Authentication → Add User로 본인 계정 생성
# 또는 service_role로 admin.createUser 호출. 여기에 그 user의 uuid 입력.
COACH_USER_ID=

# --- GitHub username (signal 수집 대상) ---
# mcp-github의 get_user_events_yesterday 호출 시 username
COACH_GITHUB_USERNAME=HyeonJ

# --- 모니터링할 GitHub repos (콤마 구분, 최대 20개) ---
# 형식: owner/name. 예: HyeonJ/cadence,HyeonJ/sprint1-toy
COACH_MONITORED_REPOS=HyeonJ/cadence

# --- Discord 일일 카드 webhook (admin과 별도 채널 권장) ---
# Routine이 매일 카드 생성 후 stage 4에서 호출.
# 같은 채널에 admin alert도 묶고 싶으면 DISCORD_ADMIN_WEBHOOK_URL과 동일하게 둬도 OK.
DISCORD_WEBHOOK_URL=

# --- PWA 링크 (선택) ---
# Discord 카드 알림에 "오늘 보기" 링크로 들어감. Plan 04 PWA 배포 후 채움.
# COACH_PWA_URL=https://cadence.your-domain.app

# ============================================================
# Plan 04 — apps/pwa (브라우저 노출, anon 권한 + RLS)
# ============================================================

# Supabase Anon key — local dev에서 supabase status로 확인 가능
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
