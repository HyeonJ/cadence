# Cadence runtime env (root)
# Copy to `.env` (gitignored) and fill values.
# Each MCP server loads this via dotenv at startup.

# --- Supabase (local dev) ---
# `pnpm supabase status`로 확인 가능. 로컬 dev 키는 모든 Supabase 인스턴스 공통.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# --- GitHub PAT (read-only) ---
# 발급: https://github.com/settings/tokens?type=beta
# 권한: Public Repositories (read), 또는 monitored_repos가 private이면 그 repo들에 contents: read
COACH_GITHUB_PAT=

# --- Discord admin webhook ---
# 발급: 채널 설정 → 통합 → 웹후크 → 새 웹후크 → URL 복사
# (mcp-discord의 send_admin_alert가 사용. send_dm은 호출 시 webhook_url을 인자로 받음)
DISCORD_ADMIN_WEBHOOK_URL=
