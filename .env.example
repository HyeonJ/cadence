# Cadence runtime env (root)
# Copy to `.env` (gitignored) and fill values.
# 모든 MCP servers + apps/routine + apps/cli + (Vercel 외부) PWA dev가 dotenv로 자동 로드.
#
# Plan 06 (Cloud 배포) 시점부터 .env는 **프로덕션 (Supabase Cloud)** 자격을 담음.
# 로컬 Supabase는 vitest용 — 각 패키지 .env.test에 분리 (gitignored).
#
# 빈 칸은 본인이 채워야 함. 주석 (#)로 표시된 라인은 참고/예시.

# ============================================================
# Supabase — Cloud (프로덕션)
# ============================================================
# 발급: Supabase Cloud Dashboard → Project Settings → API
#   - Project URL → SUPABASE_URL · NEXT_PUBLIC_SUPABASE_URL
#   - anon public key → NEXT_PUBLIC_SUPABASE_ANON_KEY (브라우저 노출 OK, RLS로 보호)
#   - service_role secret key → SUPABASE_SERVICE_ROLE_KEY (절대 PWA에 X · routine만)

SUPABASE_URL=https://<your-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SUPABASE_URL=https://<your-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Plan 01-05 시점 로컬 Supabase 값 (참고 — vitest용은 packages/*/.env.test에 분리):
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# ============================================================
# Anthropic Claude API (routine 필수)
# ============================================================
# 발급: https://console.anthropic.com/ → API keys → Create Key
ANTHROPIC_API_KEY=

# ============================================================
# Coach user (Supabase Auth) — Cloud의 본인 user uuid
# ============================================================
# 본인 사용자가 처음 로그인하면 auth.users에 row 생성됨.
# Cloud Studio → Authentication → Users 탭에서 uuid 복사.
# 또는 처음 PWA 로그인 후 Onboarding 거치면 user_settings.user_id가 그 uuid임.
COACH_USER_ID=

# ============================================================
# GitHub (mcp-github 신호 수집)
# ============================================================
# PAT 발급: https://github.com/settings/tokens?type=beta
# 권한: Public Repositories (read), 또는 private repo면 contents: read
COACH_GITHUB_PAT=

# username + 모니터 repos (콤마 구분, 최대 20개)
COACH_GITHUB_USERNAME=HyeonJ
COACH_MONITORED_REPOS=HyeonJ/cadence

# ============================================================
# Discord webhooks
# ============================================================
# 발급: Discord 채널 설정 → 통합 → 웹후크 → 새 웹후크 → URL 복사

# 일일 카드 알림 (routine stage 4에서 호출)
DISCORD_WEBHOOK_URL=

# 헬스체크/실패 알림 (admin) — 같은 채널 OK, 별도 채널 권장
DISCORD_ADMIN_WEBHOOK_URL=

# ============================================================
# PWA 링크 (선택)
# ============================================================
# Discord 카드 알림에 "오늘 보기" 링크로 들어감.
# Plan 06 Vercel 배포 후 vercel.app URL을 채움. 본인 도메인이면 그 값.
# COACH_PWA_URL=https://cadence-bpx27.vercel.app
